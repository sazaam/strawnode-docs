extends ./basecontent
block content
	//- +videoblock

	//- +log(typeof module == 'undefined' )
	
	- var isHome = response.id == '@' ;
	- let resid = response.id ;
	- var isDeck = response.userData.deck ;

	case resid
		when '@'
			break
		
		when 'about'
			.VpadXLg(class="max-w-80")
				.HpadXXLg.txtL.unselectable
					+article_about()
		
		when 'intro'
			//- 
			.about.slides.sizeR.rel.context.flowvisible.unselectable(class="md:max-w-128")
				.about_intro.rel.lhXLg.line.glass(class="txtJ" style="width:300%;left:0%")
					- var els = ['reason', 'outside', 'everything_is_step'] ;
					each ctx, i in els
						- var rctx = 'about.intro.' + ctx ;
						.unit.size1of3( style="opacity:"+(i==0? "1" : ".3"))
							.lhLg.whitetranspTXT.marXXXLg.BpadXXXLg
								.flex.flex-row.items-end(class="gap-6")
									.txtJ.shrink
										:md
											### **#{t(rctx)}**
											<br>
											!{t(rctx, {context:"desc"})}
									.img(class="flex-none" style="width:100px;height:100px")
										case i
											when 1 
												+svg_tree
											when 2 
												+svg_foot
											default
												+svg_spiral

				.pagination.abs.bottom0.right0.RmarXXXLg.Rpad.BmarXLg.sizeSm.unselectable
					span.block.floatR
						span.num= 1 
						|  /  #{els.length}
				
				+lr_arrows('l', 'b', 'LmarXXLg Bmar')
		
		when 'contact'
			.VpadXLg(class="max-w-96")
				.HpadXXLg.txtL.unselectable
					form.contact_form.rel(class="flex flex-col gap-5" onsubmit="Contact.submit(this);return false;")
						div.field.glass.rounded.padding
							label.block.txtL.sizeSm.HpadXSm.whitetranspTXT= t('contact.name')
							input.inputs.block.fullW.HpadXSm(type="text" name="name" placeholder=t('contact.name_ph') required)
						div.field.glass.rounded.padding
							label.block.txtL.sizeSm.HpadXSm.whitetranspTXT= t('contact.email')
							input.inputs.block.fullW.HpadXSm(type="email" name="email" placeholder=t('contact.email_ph') required)
						div.field.glass.rounded.padding
							label.block.txtL.sizeSm.HpadXSm.whitetranspTXT= t('contact.subject')
							input.inputs.block.fullW.HpadXSm(type="text" name="subject" placeholder=t('contact.subject_ph'))
						div.field.glass.rounded.padding
							label.block.txtL.sizeSm.HpadXSm.whitetranspTXT= t('contact.message')
							textarea.inputs.block.fullW.HpadXSm(rows="6" name="message" placeholder=t('contact.message_ph') required)
						.hpwrap(style="position:absolute;left:-9999px;top:-9999px;height:0;overflow:hidden" aria-hidden="true")
							label= t('contact.name')
							input(type="text" name="website" tabindex="-1" autocomplete="off")
						button.item.dispBlock.padding.HpadXLg.sizeSm.rounded.whitetranspBG(type="button" class="contact_submit self-start" onclick="Contact.submit(this.form)")
							span.submit_label= t('contact.submit')
					.contact_status.none.sizeSm.txtL.whitetranspTXT.Tmar
					.contact_success.sizeSm.txtL.whitetranspTXT.Tmar.none(style="min-height:200px" class="flex flex-row items-center")!= t('contact.success')
		
		when 'vision'
			.vision.rel.fullH.flowYauto.unselectable.visionzone
				- var blocks = new Array(11) ;
				- var len = blocks.length ;
				- var toDeca = function(n){return (n < 10 ? '0' : '') + n }
				
				.vision_panel.fullW(style="height:" + len + "00%;")
					each art, i in blocks
						- var pos = parseInt(i) * 100 ;
						- var rctx = 'explains.ex_' + toDeca(i + 1) ;
						
						article.abs.fullW.fullH(class="" style="top:" + pos + "%")
							
							.txtL.post.h-full(class="flex flex-row items-center")
								
								.vcentered.fullW.rel(class="padXXXLg"  style="border:1px solid rgba(235, 235, 235, .25);border-width:1px 0;color:#CCC")
									.fullW.fullH.abs.top0.left0.context.glass
										.spark.rel
											- var ll = 30 ;
											- for(var ii = 0 ; ii < ll ; ii ++){
												.box.abs(style="top:-200px;left:-200px;") 
													.el.rel
											- }

									.hcentered.rel(class="md:max-w-128")
										h3.sizeLg.Bmar.Lpad(style="border-left:4px solid #CCC;")
											!= t(rctx)
										p.sizeRM
											!= t(rctx, {context:'text'})
										
										- if(i == len - 1){
											.TmarXXLg
												+gen_alpha_link(t('vision.cta_contact'), '#/' + lang + '/contact/', 'furtherlink')
										- }
										
										- if(i > 0){
											.abs.top0.pad.sizeLg(style="margin-top:-120px")
												a.prev(href="javascript:void(0)" data-index=i) &uarr;
										- }
										- if(i < len - 1){
											.abs.bottom.pad.sizeLg(style="margin-top:105px")
												a.next(href="javascript:void(0)" data-index=i) &darr;
										- }
										- if(0){
											.vision_families.flex(class="flex-row gap-4 TmarXXLg")
												each fam in [['make', t('sections.make')], ['light', t('sections.light')], ['story', t('sections.story')], ['build', t('sections.build')]]
													a.item.rel.dispBlock.padding.sizeSm.HpadXLg.rounded.white(class="whitetranspBG" href="#/#{lang}/works/#{fam[0]}/")= fam[1]
										- }
										
		when 'strawnode'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('strawnode.article', 'doc_article')
		when 'betweenjs'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('betweenjs.article', 'doc_article')
		when 'type'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('type.article', 'doc_article')
		when 'shaders'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('shaders.article', 'doc_article')
		when 'modelling'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('modelling.article', 'doc_article')
		when 'procedural'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('procedural.article', 'doc_article')
		when 'tweens'
			.docs_leaf.VpadXLg.glass(class="md:max-w-240")
				.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
					+article('tweens.article', 'doc_article')
		default
			if isDeck
				div.fullH(class="md:max-w-90 self-center")
					- var hh = 202 ;
					.projects_list.fullH.fullW.context.rel.lhXLg.whitetransp(class="txtJ md:border-r")
						.project_panes.rel.fullW
							- var els = response.children ;
							- els = els.length < 6 ? els.concat(els) : els ;
							- var l = els.length ;
							- var baseop = .2 ;
							for el, i in els
								- var op = i == 0 ? 1 : baseop ;
								- var top = i < Math.floor(l / 2) ? i * hh : (i-l) * hh ;
								.abs.project_pane.glass.context(named=el.id + "" straw="project_pane_" + i, style="opacity:#{op};top:#{top}px;width:360px;height:" + hh + "px")
									
									.innerslide.fullW.fullH.flowvisible.rel(style="left:0%") 
										+project_pane(el, false)
										+extra_panes(el)
									+lr_arrows_justtransp('r', 'b', 'panenav BmarSm Rmar white sizeM')
							
							//- +yt("TJORWNcMoU8", "PHa7_EzqBICBXSi5&amp", 0, 1)
			else
				.VpadXLg(class="md:max-w-80")
					.HpadXXLg.TpadSm.whitetranspTXT.txtL.unselectable.sizeRM
						+article(response.name + '.article')
	
	